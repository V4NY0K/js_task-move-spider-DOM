"use strict";
document.addEventListener("click", function(e) {
    var spider = document.querySelector(".spider");
    var wall = document.querySelector(".wall");
    var wallRect = wall.getBoundingClientRect();
    if (e.clientX < wallRect.left || e.clientX > wallRect.right || e.clientY < wallRect.top || e.clientY > wallRect.bottom) return;
    var spiderRect = spider.getBoundingClientRect();
    var relativeX = e.clientX - wallRect.left - wall.clientLeft;
    var relativeY = e.clientY - wallRect.top - wall.clientTop;
    var desiredLeft = relativeX - spiderRect.width / 2;
    var desiredTop = relativeY - spiderRect.height / 2;
    var maxLeft = wall.clientWidth - spiderRect.width;
    var maxTop = wall.clientHeight - spiderRect.height;
    var newLeft = Math.max(0, Math.min(desiredLeft, maxLeft));
    var newTop = Math.max(0, Math.min(desiredTop, maxTop));
    spider.style.left = newLeft + "px";
    spider.style.top = newTop + "px";
});

